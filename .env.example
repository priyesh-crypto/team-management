# Copy this file to .env.local and fill in real values.
# Without these, `next build` / `next dev` will fail — server components read
# them directly (e.g. src/utils/supabase/admin.ts throws if the Supabase vars
# are missing), so at minimum the Supabase vars below must be set.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Upstash (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Anthropic (AI features)
ANTHROPIC_API_KEY=
